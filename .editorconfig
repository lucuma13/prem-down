root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = unset

[*.{yaml,yml}]
indent_size = 2

[*.go]
indent_style = tab
indent_size = unset

[{go.mod,go.sum}]
indent_style = tab
indent_size = unset

[internal/premdown/testdata/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
